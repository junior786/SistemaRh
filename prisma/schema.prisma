// RH Selector — Prisma Schema
// Portável entre PostgreSQL, SQLite e Supabase
// Regra: zero SQL direto no código — tudo via Prisma Client

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// VAGAS
// ─────────────────────────────────────────────

model Vaga {
  id          String      @id @default(cuid())
  titulo      String
  area        String
  jobType     String      // tipo de trabalho: Desenvolvedor, Motorista, Doméstica etc.
  regime      Regime
  modalidade  Modalidade
  localizacao String
  cep         String?     // obrigatório se presencial ou híbrido
  salarioMin  Float?
  salarioMax  Float?
  descricao   String
  status          VagaStatus  @default(ABERTA)
  preTriagemIds   String?     // JSON: IDs de candidatos selecionados pela pré-triagem IA
  preTriagemMotivo String?    // motivo/critério usado pela IA
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  requisitos  Requisito[]
  etapas      VagaEtapa[]
  triagens    Triagem[]
  empregados  Candidato[] @relation("empregados")
}

enum Regime {
  CLT
  PJ
  ESTAGIO
  FREELANCER
}

enum Modalidade {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum VagaStatus {
  ABERTA
  EM_REVISAO
  FECHADA
}

// Requisito pertence a uma vaga
// OBRIGATORIO = eliminatório (score máx 50% se não atender)
// DESEJAVEL   = pesa proporcionalmente no score
model Requisito {
  id            String        @id @default(cuid())
  vagaId        String
  descricao     String
  tipo          RequisitoTipo
  tempoMeses    Int?          // tempo mínimo de experiência em meses (ex: 24 = 2 anos)
  createdAt     DateTime      @default(now())

  vaga Vaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)
}

enum RequisitoTipo {
  OBRIGATORIO
  DESEJAVEL
}

model VagaEtapa {
  id          String       @id @default(cuid())
  vagaId      String
  nome        String
  tipo        VagaEtapaTipo
  ordem       Int
  obrigatoria Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  vaga        Vaga         @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  triagens    TriagemEtapa[]
  entrevistas Entrevista[]

  @@unique([vagaId, ordem])
}

enum VagaEtapaTipo {
  TRIAGEM
  ENTREVISTA
  TESTE_TECNICO
  DINAMICA
  ENTREVISTA_GESTOR
  OFERTA
  ADMISSAO
  OUTRO
}

// ─────────────────────────────────────────────
// CANDIDATOS
// ─────────────────────────────────────────────

model Candidato {
  id                String          @id @default(cuid())
  nome              String
  email             String          @unique
  telefone          String?
  cidade            String?
  cep               String?
  genero            String?         // texto livre: Masculino, Feminino, Não-binário, etc.
  resumo            String?
  jobType           String          // tipo de trabalho pretendido
  pretensaoSalarial Float?
  observacao        String?         // notas internas editáveis pelo RH
  statusEmprego     StatusEmprego   @default(DISPONIVEL)
  vagaEmpregadoId   String?         // vaga em que foi contratado
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  skills       CandidatoSkill[]
  experiencias Experiencia[]
  formacoes    Formacao[]
  triagens     Triagem[]
  restricoes   Restricao[]
  vagaEmpregado Vaga?  @relation("empregados", fields: [vagaEmpregadoId], references: [id], onDelete: SetNull)
}

enum StatusEmprego {
  DISPONIVEL    // procurando emprego
  EMPREGADO     // contratado em uma vaga do sistema
  INATIVO       // não está buscando no momento
}

// Restrições / informações pessoais relevantes para a triagem
// Exemplos: "Tem 2 filhos", "Não possui CNH", "Disponível apenas manhã"
model Restricao {
  id          String   @id @default(cuid())
  candidatoId String
  descricao   String
  createdAt   DateTime @default(now())

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Skills como tabela separada para facilitar buscas e filtros futuros
model CandidatoSkill {
  id          String   @id @default(cuid())
  candidatoId String
  nome        String
  createdAt   DateTime @default(now())

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Experiência profissional
// dataFim = null quando atual = true
model Experiencia {
  id          String    @id @default(cuid())
  candidatoId String
  empresa     String
  cargo       String
  descricao   String?
  dataInicio  DateTime
  dataFim     DateTime? // null = emprego atual
  atual       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Formação acadêmica
// dataFim = null quando atual = true
model Formacao {
  id          String        @id @default(cuid())
  candidatoId String
  instituicao String
  curso       String
  nivel       NivelFormacao
  dataInicio  DateTime
  dataFim     DateTime?     // null = cursando atualmente
  atual       Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

enum NivelFormacao {
  TECNICO
  GRADUACAO
  POS_GRADUACAO
  MBA
  MESTRADO
  DOUTORADO
  CURSO_LIVRE
}

// ─────────────────────────────────────────────
// TRIAGEM (vaga ↔ candidato)
// ─────────────────────────────────────────────

// Entidade central do sistema
// Representa a análise de um candidato para uma vaga específica
model Triagem {
  id          String        @id @default(cuid())
  vagaId      String
  candidatoId String
  status      TriagemStatus @default(PENDENTE)

  // Score gerado pela IA (0–100)
  score       Float?

  // Análise textual completa retornada pela IA
  analise     String?

  // Checklist de requisitos em JSON: [{requisito, atende, observacao}]
  // Armazenado como string para não depender de tipo JSON nativo do banco
  checklist   String?

  // Controle de desatualização (RN-03)
  // true quando perfil ou requisitos mudam após análise
  desatualizado Boolean   @default(false)

  analisadoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entrevistas Entrevista[]
  etapas      TriagemEtapa[]

  vaga      Vaga      @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  // Um candidato só pode ter uma triagem por vaga
  @@unique([vagaId, candidatoId])
}

enum TriagemStatus {
  PENDENTE     // aguardando análise da IA
  PROCESSANDO  // IA analisando no momento
  CONCLUIDO    // score disponível
  ERRO         // falha na análise — pode tentar novamente
}

// ─────────────────────────────────────────────
// ENTREVISTAS
// ─────────────────────────────────────────────

model TriagemEtapa {
  id          String             @id @default(cuid())
  triagemId   String
  vagaEtapaId String
  status      TriagemEtapaStatus @default(PENDENTE)
  observacao  String?
  iniciadaEm  DateTime?
  concluidaEm DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  triagem   Triagem   @relation(fields: [triagemId], references: [id], onDelete: Cascade)
  vagaEtapa VagaEtapa @relation(fields: [vagaEtapaId], references: [id], onDelete: Cascade)

  @@unique([triagemId, vagaEtapaId])
}

enum TriagemEtapaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  REPROVADO
  DISPENSADO
}

// Vinculada ao par candidato + vaga via Triagem
// Um par pode ter múltiplas entrevistas (técnica, gestor, etc.)
model Entrevista {
  id               String             @id @default(cuid())
  triagemId        String
  vagaEtapaId      String?
  dataHora         DateTime
  entrevistador    String
  status           EntrevistaStatus   @default(AGENDADA)
  observacoes      String?
  resultado        EntrevistaResultado?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  triagem   Triagem   @relation(fields: [triagemId], references: [id], onDelete: Cascade)
  vagaEtapa VagaEtapa? @relation(fields: [vagaEtapaId], references: [id], onDelete: SetNull)
}

enum EntrevistaStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum EntrevistaResultado {
  APROVADO
  REPROVADO
  PROXIMA_FASE
}
