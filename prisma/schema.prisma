// RH Selector — Prisma Schema
// Portável entre PostgreSQL, SQLite e Supabase
// Regra: zero SQL direto no código — tudo via Prisma Client

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// EMPRESA
// ─────────────────────────────────────────────

model Empresa {
  id                String         @id @default(cuid())
  nome              String
  slug              String         @unique
  dominioCustom     String?        @unique
  status            EmpresaStatus  @default(ATIVA)
  timezone          String         @default("America/Sao_Paulo")
  logoUrl           String?
  corPrimaria       String?
  iaWhatsappAtivo   Boolean        @default(false)
  iaPersona         String?
  iaTomVoz          String?
  iaFAQ             String?
  iaBlocklist       String?
  iaModoDraft       Boolean        @default(false)
  twilioAccountSid  String?        @unique
  twilioAuthToken   String?
  twilioFromNumber  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  templatesWhats    TwilioTemplate[]
  usuarios          EmpresaUsuario[]
  vagas             Vaga[]
  candidatos        Candidato[]
  categorias        Categoria[]
  triagens          Triagem[]
  triagemEventos    TriagemEvento[]
  mensagens         Mensagem[]
  controlesConversa ControleConversa[]
}

enum EmpresaStatus {
  ATIVA
  SUSPENSA
  INATIVA
}

// ─────────────────────────────────────────────
// USUÁRIOS E AUTORIZAÇÃO
// ─────────────────────────────────────────────

// Identidade local espelha usuário do Firebase Auth.
// firebaseUid é a chave de junção com o token validado pelo backend.
model Usuario {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  nome        String
  email       String   @unique
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresas EmpresaUsuario[]
}

// Vínculo entre usuário e empresa com papel de autorização.
// Um usuário pode pertencer a várias empresas com papéis distintos.
model EmpresaUsuario {
  id         String   @id @default(cuid())
  empresaId  String
  usuarioId  String
  role       Role     @default(RECRUITER)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([empresaId, usuarioId])
  @@index([usuarioId])
}

enum Role {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

// Templates aprovados no Twilio Content Builder
// contentSid identifica o template; variaveis lista os placeholders esperados ({{1}}, {{2}}...)
model TwilioTemplate {
  id           String   @id @default(cuid())
  empresaId    String
  slug         String   // identificador interno usado pelo código (ex: "convite_entrevista")
  nome         String
  contentSid   String   // HX... do Twilio
  variaveis    String   // CSV ordenado: "data,horario" mapeia para {"1": data, "2": horario}
  descricao    String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, slug])
}

// ─────────────────────────────────────────────
// CONFIGURAÇÕES
// ─────────────────────────────────────────────

// Categorias configuráveis (áreas de atuação, tipos de trabalho, etc.)
model Categoria {
  id        String   @id @default(cuid())
  empresaId String
  tipo      String   // "AREA_ATUACAO" | "TIPO_TRABALHO" etc.
  nome      String
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo, nome])
  @@index([empresaId])
}

// ─────────────────────────────────────────────
// VAGAS
// ─────────────────────────────────────────────

model Vaga {
  id          String      @id @default(cuid())
  empresaId   String
  titulo      String
  area        String
  jobType     String
  regime      Regime
  modalidade  Modalidade
  localizacao String
  cep         String?
  salarioMin  Float?
  salarioMax  Float?
  descricao   String
  status           VagaStatus @default(ABERTA)
  preTriagemIds    String?
  preTriagemMotivo String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  areas       VagaArea[]
  requisitos  Requisito[]
  etapas      VagaEtapa[]
  triagens    Triagem[]
  empregados  Candidato[] @relation("empregados")

  @@index([empresaId])
}

enum Regime {
  CLT
  PJ
  ESTAGIO
  FREELANCER
}

enum Modalidade {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum VagaStatus {
  ABERTA
  EM_REVISAO
  FECHADA
}

// Áreas de atuação da vaga (ex: Desenvolvimento, Liderança Técnica)
model VagaArea {
  id        String   @id @default(cuid())
  vagaId    String
  nome      String
  createdAt DateTime @default(now())

  vaga Vaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)
}

// Requisito pertence a uma vaga
// OBRIGATORIO = eliminatório (score máx 50% se não atender)
// DESEJAVEL   = pesa proporcionalmente no score
model Requisito {
  id            String        @id @default(cuid())
  vagaId        String
  descricao     String
  tipo          RequisitoTipo
  tempoMeses    Int?          // tempo mínimo de experiência em meses (ex: 24 = 2 anos)
  createdAt     DateTime      @default(now())

  vaga Vaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)
}

enum RequisitoTipo {
  OBRIGATORIO
  DESEJAVEL
}

model VagaEtapa {
  id          String       @id @default(cuid())
  vagaId      String
  nome        String
  tipo        VagaEtapaTipo
  ordem       Int
  obrigatoria Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  vaga        Vaga         @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  triagens    TriagemEtapa[]
  entrevistas Entrevista[]

  @@unique([vagaId, ordem])
}

enum VagaEtapaTipo {
  TRIAGEM
  ENTREVISTA
  TESTE_TECNICO
  DINAMICA
  ENTREVISTA_GESTOR
  OFERTA
  ADMISSAO
  OUTRO
}

// ─────────────────────────────────────────────
// CANDIDATOS
// ─────────────────────────────────────────────

model Candidato {
  id                String          @id @default(cuid())
  empresaId         String
  nome              String
  email             String
  telefone          String?
  cidade            String?
  cep               String?
  genero            String?
  resumo            String?
  jobType           String
  pretensaoSalarial Float?
  observacao        String?
  statusEmprego     StatusEmprego   @default(DISPONIVEL)
  vagaEmpregadoId   String?
  contratadoEm      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  empresa      Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  areas        CandidatoArea[]
  skills       CandidatoSkill[]
  experiencias Experiencia[]
  formacoes    Formacao[]
  triagens     Triagem[]
  restricoes   Restricao[]
  mensagens    Mensagem[]
  controleConversa ControleConversa?
  vagaEmpregado    Vaga? @relation("empregados", fields: [vagaEmpregadoId], references: [id], onDelete: SetNull)

  @@unique([empresaId, email])
  @@index([empresaId])
}

enum StatusEmprego {
  DISPONIVEL    // procurando emprego
  EMPREGADO     // contratado em uma vaga do sistema
  INATIVO       // não está buscando no momento
}

// Restrições / informações pessoais relevantes para a triagem
// Exemplos: "Tem 2 filhos", "Não possui CNH", "Disponível apenas manhã"
model Restricao {
  id          String   @id @default(cuid())
  candidatoId String
  descricao   String
  createdAt   DateTime @default(now())

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Áreas de atuação do candidato (ex: Desenvolvimento, Liderança Técnica)
model CandidatoArea {
  id          String   @id @default(cuid())
  candidatoId String
  nome        String
  createdAt   DateTime @default(now())

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Skills como tabela separada para facilitar buscas e filtros futuros
model CandidatoSkill {
  id          String   @id @default(cuid())
  candidatoId String
  nome        String
  createdAt   DateTime @default(now())

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Experiência profissional
// dataFim = null quando atual = true
model Experiencia {
  id          String    @id @default(cuid())
  candidatoId String
  empresa     String
  cargo       String
  descricao   String?
  dataInicio  DateTime
  dataFim     DateTime? // null = emprego atual
  atual       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

// Formação acadêmica
// dataFim = null quando atual = true
model Formacao {
  id          String        @id @default(cuid())
  candidatoId String
  instituicao String
  curso       String
  nivel       NivelFormacao
  dataInicio  DateTime
  dataFim     DateTime?     // null = cursando atualmente
  atual       Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
}

enum NivelFormacao {
  TECNICO
  GRADUACAO
  POS_GRADUACAO
  MBA
  MESTRADO
  DOUTORADO
  CURSO_LIVRE
}

// ─────────────────────────────────────────────
// TRIAGEM (vaga ↔ candidato)
// ─────────────────────────────────────────────

// Entidade central do sistema
// Representa a análise de um candidato para uma vaga específica
model Triagem {
  id          String        @id @default(cuid())
  empresaId   String
  vagaId      String
  candidatoId String
  status      TriagemStatus @default(PENDENTE)

  // Score gerado pela IA (0–100)
  score       Float?

  // Análise textual completa retornada pela IA
  analise     String?

  // Checklist de requisitos em JSON: [{requisito, atende, observacao}]
  // Armazenado como string para não depender de tipo JSON nativo do banco
  checklist   String?

  // Controle de desatualização (RN-03)
  // true quando perfil ou requisitos mudam após análise
  desatualizado Boolean   @default(false)

  analisadoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entrevistas Entrevista[]
  etapas      TriagemEtapa[]
  eventos     TriagemEvento[]

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vaga      Vaga      @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  // Um candidato só pode ter uma triagem por vaga
  @@unique([vagaId, candidatoId])
  @@index([empresaId])
}

enum TriagemStatus {
  PENDENTE     // aguardando análise da IA
  PROCESSANDO  // IA analisando no momento
  CONCLUIDO    // score disponível
  ERRO         // falha na análise — pode tentar novamente
}

// ─────────────────────────────────────────────
// ENTREVISTAS
// ─────────────────────────────────────────────

model TriagemEvento {
  id            String   @id @default(cuid())
  empresaId     String
  triagemId     String?
  vagaId        String
  vagaTitulo    String
  candidatoId   String
  candidatoNome String
  tipo          String
  descricao     String
  origem        String   @default("SISTEMA")
  metadados     String?
  createdAt     DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  triagem Triagem? @relation(fields: [triagemId], references: [id], onDelete: SetNull)

  @@index([empresaId])
}

model TriagemEtapa {
  id          String             @id @default(cuid())
  triagemId   String
  vagaEtapaId String
  status      TriagemEtapaStatus @default(PENDENTE)
  observacao  String?
  iniciadaEm  DateTime?
  concluidaEm DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  triagem   Triagem   @relation(fields: [triagemId], references: [id], onDelete: Cascade)
  vagaEtapa VagaEtapa @relation(fields: [vagaEtapaId], references: [id], onDelete: Cascade)

  @@unique([triagemId, vagaEtapaId])
}

enum TriagemEtapaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  REPROVADO
  DISPENSADO
}

// Vinculada ao par candidato + vaga via Triagem
// Um par pode ter múltiplas entrevistas (técnica, gestor, etc.)
model Entrevista {
  id               String             @id @default(cuid())
  triagemId        String
  vagaEtapaId      String?
  dataHora         DateTime
  entrevistador    String
  status           EntrevistaStatus   @default(AGENDADA)
  observacoes      String?
  resultado        EntrevistaResultado?
  notificarWhats   Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  triagem   Triagem   @relation(fields: [triagemId], references: [id], onDelete: Cascade)
  vagaEtapa VagaEtapa? @relation(fields: [vagaEtapaId], references: [id], onDelete: SetNull)
}

enum EntrevistaStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum EntrevistaResultado {
  APROVADO
  REPROVADO
  PROXIMA_FASE
}

// ─────────────────────────────────────────────
// WHATSAPP
// ─────────────────────────────────────────────

model Mensagem {
  id                 String          @id @default(cuid())
  empresaId          String
  candidatoId        String
  providerMessageSid String?         @unique
  direcao            MensagemDirecao
  conteudo           String
  status             MensagemStatus  @default(ENVIADA)
  tipo               MensagemTipo    @default(LIVRE)
  templateId         String?
  geradaPorIA        Boolean         @default(false)
  iaRascunho         Boolean         @default(false)
  iaAprovadaEm       DateTime?
  criadoEm           DateTime        @default(now())
  atualizadoEm       DateTime        @updatedAt

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

// Estado de controle por candidato
// iaAtiva = false → RH assumiu, IA não responde
model ControleConversa {
  id          String    @id @default(cuid())
  empresaId   String
  candidatoId String    @unique
  iaAtiva     Boolean   @default(true)
  assumidoEm  DateTime?
  updatedAt   DateTime  @updatedAt

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  candidato Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

enum MensagemDirecao {
  ENVIADA
  RECEBIDA
}

enum MensagemStatus {
  ENVIADA
  ENTREGUE
  LIDA
  FALHA
}

enum MensagemTipo {
  LIVRE
  TEMPLATE
}
